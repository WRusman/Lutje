(version 1)
(rule "Copper to hole clearance 1"
	(constraint hole_clearance (min 0.1mm))
)
(rule "Minimum clearance 1"
	(constraint clearance (min 0.16mm))
)
(rule "Copper to edge clearance 1"
	(constraint edge_clearance (min 0.2mm))
)
(rule "Vias under SMD 1"
	(constraint disallow micro_via blind_via buried_via)
	(condition "A.Pad_Type == 'SMD'")
)
